# Root, it drives tailscale set. The page it writes is world readable for
# nginx, ProtectSystem keeps it from writing anywhere but its state
# directory.
[Unit]
Description=Check the other hosts and alert on Slack
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/default/watchdog
ExecStart=/usr/local/bin/watchdog
StateDirectory=watchdog
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
