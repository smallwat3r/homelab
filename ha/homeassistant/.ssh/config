# Home Assistant reaches the Pi it runs on (host networking) with a key
# that can only run ivpn-ctl there. Key and known_hosts are generated by
# ha/setup.sh next to this file, never in the repo.
Host ha
  HostName 127.0.0.1
  User pi
  IdentityFile /config/.ssh/ivpn
  UserKnownHostsFile /config/.ssh/known_hosts
  StrictHostKeyChecking yes
  BatchMode yes
